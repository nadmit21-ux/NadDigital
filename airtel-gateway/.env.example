PORT=8080
NODE_ENV=production

# Shared secret used only between Supabase Edge Functions and this gateway.
GATEWAY_SHARED_SECRET=replace-with-a-long-random-secret

# Airtel TEST environment.
AIRTEL_BASE_URL=https://openapiuat.airtel.cd
AIRTEL_PAYMENT_PATH=/merchant/v2/payments/
AIRTEL_COUNTRY=CD
AIRTEL_DEFAULT_CURRENCY=USD

# Fill these only on the server hosting platform, never in GitHub.
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_TOKEN_URL=

# Keep false until Airtel's Encryption / Message Signing configuration is confirmed.
AIRTEL_MESSAGE_SIGNING=false

# Gateway starts safely without contacting Airtel while true.
DRY_RUN=true
