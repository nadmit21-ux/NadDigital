# Server
PORT=8080
GATEWAY_SHARED_SECRET=replace-with-a-long-random-secret
MAX_BODY_BYTES=65536
MAX_CLOCK_SKEW_SECONDS=300

# Airtel environment
AIRTEL_MODE=TEST
AIRTEL_COUNTRY=CD
AIRTEL_CURRENCY=USD
AIRTEL_BASE_URL=https://openapiuat.airtel.cd

# Never commit real Airtel credentials here.
# Add them only on the server once Airtel approves the product and the
# Encryption/OAuth2 settings have been reviewed from the official portal.
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_SIGNING_ENABLED=true
AIRTEL_ENCRYPTION_ENABLED=true
